# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets.
# NEVER commit the real secrets.toml.

APP_BASE_URL = "http://localhost:8501"          # your public app URL, no trailing slash
# OAUTH_REDIRECT_URI = "http://localhost:8501/"  # optional; defaults to APP_BASE_URL + "/"

# Database: leave blank for local SQLite (data/edubridge.db). For hosting, use PostgreSQL:
# DATABASE_URL = "postgresql://user:password@host:5432/dbname"
# DATABASE_PATH = "data/edubridge.db"

# AI assistant (Anthropic API)
ANTHROPIC_API_KEY = ""
# AI_MODEL = "claude-sonnet-5-5"

# Google OAuth
GOOGLE_CLIENT_ID = ""
GOOGLE_CLIENT_SECRET = ""

# GitHub OAuth
GITHUB_CLIENT_ID = ""
GITHUB_CLIENT_SECRET = ""

# SMTP for password-reset emails
SMTP_HOST = ""
SMTP_PORT = "587"          # 587 = STARTTLS, 465 = SSL
SMTP_USER = ""
SMTP_PASSWORD = ""
SMTP_FROM = "EduBridge-AI <no-reply@example.com>"
